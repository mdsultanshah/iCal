@inject IJSRuntime Js

<div class="copy-row">
    @if (Href is null)
    {
        <p class="copy-text">@Text</p>
    }
    else
    {
        <a href="@Href">@Text</a>
    }
    <button type="button" class="secondary" @onclick="Copy">@(_copied ? "Copied" : "Copy")</button>
</div>

@code {
    [Parameter, EditorRequired] public string Text { get; set; } = "";
    [Parameter] public string? Href { get; set; }
    [Parameter] public string? CopyText { get; set; }

    private bool _copied;

    private async Task Copy()
    {
        await Js.InvokeVoidAsync("northQuay.copy", CopyText ?? Text);
        _copied = true;
        StateHasChanged();
        await Task.Delay(1200);
        _copied = false;
    }
}
