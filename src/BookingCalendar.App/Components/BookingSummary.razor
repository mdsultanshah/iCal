<dl class="summary-list">
    <div>
        <dt>Service</dt>
        <dd>@ServiceName <span class="meta">@LengthMinutes min</span></dd>
    </div>
    <div>
        <dt>Date</dt>
        <dd>@DateText</dd>
    </div>
    <div>
        <dt>Time</dt>
        <dd>@TimeText</dd>
    </div>
    <div>
        <dt>Name</dt>
        <dd>@CustomerName</dd>
    </div>
    @if (!string.IsNullOrWhiteSpace(CustomerEmail))
    {
        <div>
            <dt>Email</dt>
            <dd>@CustomerEmail</dd>
        </div>
    }
</dl>

@code {
    [Parameter, EditorRequired] public string ServiceName { get; set; } = "";
    [Parameter, EditorRequired] public int LengthMinutes { get; set; }
    [Parameter, EditorRequired] public string DateText { get; set; } = "";
    [Parameter, EditorRequired] public string TimeText { get; set; } = "";
    [Parameter, EditorRequired] public string CustomerName { get; set; } = "";
    [Parameter] public string? CustomerEmail { get; set; }
}
