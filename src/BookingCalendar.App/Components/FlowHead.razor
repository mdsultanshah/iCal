@if (Step is int step)
{
    <p class="step-now">Step @step of 5 · @Labels[step - 1]</p>
    <ol class="stepper" aria-label="Booking steps">
        @for (var index = 0; index < Labels.Length; index++)
        {
            var number = index + 1;
            var state = number == step ? "is-current" : number < step ? "is-done" : "";
            <li class="step @state">@Labels[index]</li>
        }
    </ol>
}
<h1>@Title</h1>

@code {
    private static readonly string[] Labels = ["Service", "Date", "Slot", "Details", "Review"];

    [Parameter] public int? Step { get; set; }
    [Parameter, EditorRequired] public string Title { get; set; } = "";
}
