@implements IAsyncDisposable
@inject IJSRuntime JS

<div class="scrim">
    <div class="panel"
         role="dialog"
         aria-modal="true"
         aria-labelledby="panel-title"
         data-dialog
         data-panel="@Mode"
         tabindex="-1">
        @if (Mode == "delete")
        {
            <h2 id="panel-title">Delete this appointment?</h2>
            <div class="actions">
                <button type="button" id="confirm-delete" class="danger" @onclick="OnConfirmDelete">Delete</button>
                <button type="button" id="keep-appointment" class="ghost" @onclick="OnCancel">Keep</button>
            </div>
        }
        else if (Mode == "clear")
        {
            <h2 id="panel-title">Clear example appointments?</h2>
            <p class="note">This removes the sample appointments. Appointments you added stay.</p>
            <div class="actions">
                <button type="button" id="confirm-clear" class="danger" @onclick="OnConfirmClear">Clear examples</button>
                <button type="button" id="keep-examples" class="ghost" @onclick="OnCancel">Keep</button>
            </div>
        }
        else
        {
            <h2 id="panel-title">@(Mode == "edit" ? "Edit appointment" : "New appointment")</h2>
            @if (IsExample)
            {
                <p class="example-flag"><span class="badge">Example</span></p>
            }
            <form @onsubmit="Submit" @onsubmit:preventDefault novalidate>
                <label for="appointment-title">Title</label>
                <input id="appointment-title"
                       type="text"
                       value="@_title"
                       aria-invalid="@Invalid(TitleError)"
                       aria-describedby="@Described(TitleError, "title-error")"
                       @oninput="OnTitle" />
                @if (TitleError is not null)
                {
                    <p id="title-error" class="field-error">@TitleError</p>
                }

                <label for="appointment-date">Date</label>
                <input id="appointment-date"
                       type="date"
                       value="@_date"
                       aria-invalid="@Invalid(DateError)"
                       aria-describedby="@Described(DateError, "date-error")"
                       @oninput="OnDate" />
                @if (DateError is not null)
                {
                    <p id="date-error" class="field-error">@DateError</p>
                }

                <label for="appointment-start">Start</label>
                <input id="appointment-start"
                       type="time"
                       value="@_start"
                       aria-invalid="@Invalid(StartError)"
                       aria-describedby="@Described(StartError, "start-error")"
                       @oninput="OnStart" />
                @if (StartError is not null)
                {
                    <p id="start-error" class="field-error">@StartError</p>
                }

                <label for="appointment-end">End</label>
                <input id="appointment-end"
                       type="time"
                       value="@_end"
                       aria-invalid="@Invalid(EndError)"
                       aria-describedby="@Described(EndError, "end-error")"
                       @oninput="OnEnd" />
                @if (EndError is not null)
                {
                    <p id="end-error" class="field-error">@EndError</p>
                }

                <label for="appointment-note">Note</label>
                <input id="appointment-note" type="text" value="@_note" @oninput="OnNote" />

                <div class="actions">
                    <button type="submit" id="save-appointment" class="primary">Save</button>
                    <button type="button" id="cancel-appointment" class="ghost" @onclick="OnCancel">Cancel</button>
                    @if (Mode == "edit")
                    {
                        <button type="button" id="delete-appointment" class="danger" @onclick="OnAskDelete">Delete</button>
                    }
                </div>
            </form>
        }
    </div>
</div>

@code {
    private readonly string _bindId = Guid.NewGuid().ToString("N");
    private DotNetObjectReference<AppointmentPanel>? _self;
    private string _title = "";
    private string _date = "";
    private string _start = "";
    private string _end = "";
    private string _note = "";

    [Parameter]
    public string Mode { get; set; } = "create";

    [Parameter]
    public string? Id { get; set; }

    [Parameter]
    public string Title { get; set; } = "";

    [Parameter]
    public string Date { get; set; } = "";

    [Parameter]
    public string Start { get; set; } = "";

    [Parameter]
    public string End { get; set; } = "";

    [Parameter]
    public string Note { get; set; } = "";

    [Parameter]
    public bool IsExample { get; set; }

    [Parameter]
    public string? TitleError { get; set; }

    [Parameter]
    public string? DateError { get; set; }

    [Parameter]
    public string? StartError { get; set; }

    [Parameter]
    public string? EndError { get; set; }

    [Parameter]
    public EventCallback<string> OnClearError { get; set; }

    [Parameter]
    public EventCallback<AppointmentDraft> OnSave { get; set; }

    [Parameter]
    public EventCallback OnCancel { get; set; }

    [Parameter]
    public EventCallback OnAskDelete { get; set; }

    [Parameter]
    public EventCallback OnConfirmDelete { get; set; }

    [Parameter]
    public EventCallback OnConfirmClear { get; set; }

    protected override void OnInitialized()
    {
        _title = Title;
        _date = Date;
        _start = Start;
        _end = End;
        _note = Note;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;

        _self = DotNetObjectReference.Create(this);
        await JS.InvokeVoidAsync("northQuay.bindDialog", _bindId, _self);
        var target = Mode switch
        {
            "delete" => "#keep-appointment",
            "clear" => "#keep-examples",
            _ => "#appointment-title",
        };
        await JS.InvokeVoidAsync("northQuay.focus", target);
    }

    [JSInvokable]
    public Task CloseFromKey() => OnCancel.InvokeAsync();

    public async ValueTask DisposeAsync()
    {
        try
        {
            await JS.InvokeVoidAsync("northQuay.unbindDialog", _bindId);
        }
        catch (JSException)
        {
            // The page is going away.
        }

        _self?.Dispose();
    }

    private Task Submit() =>
        OnSave.InvokeAsync(new AppointmentDraft(Id, _title, _date, _start, _end, _note));

    private void OnTitle(ChangeEventArgs e)
    {
        _title = e.Value?.ToString() ?? "";
        Clear("title", TitleError);
    }

    private void OnDate(ChangeEventArgs e)
    {
        _date = e.Value?.ToString() ?? "";
        Clear("date", DateError);
    }

    private void OnStart(ChangeEventArgs e)
    {
        _start = e.Value?.ToString() ?? "";
        Clear("start", StartError);
    }

    private void OnEnd(ChangeEventArgs e)
    {
        _end = e.Value?.ToString() ?? "";
        Clear("end", EndError);
    }

    private void Clear(string field, string? error)
    {
        if (error is not null)
            _ = OnClearError.InvokeAsync(field);
    }

    private void OnNote(ChangeEventArgs e) => _note = e.Value?.ToString() ?? "";

    private static string? Invalid(string? error) => error is null ? null : "true";

    private static string? Described(string? error, string id) => error is null ? null : id;
}
