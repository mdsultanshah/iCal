@inherits LayoutComponentBase
@inject StudioSession Session
@inject NavigationManager Nav

<div class="shell">
    <header class="studio">
        <div>
            <p class="place">@Catalog.Neighbourhood</p>
            <a class="mark" href="/">@Catalog.BusinessName</a>
            <p class="provider">@Catalog.ProviderName · one provider</p>
            <div class="only-wide">
                <p>Monday to Friday, 9:00 to 17:00, Singapore time. Three services, each with a fixed length. No account.</p>
            </div>
        </div>
        <p class="hours">Mon–Fri · 9:00–17:00 · Singapore</p>
    </header>
    <div class="flow">
        @if (Session.IsReady)
        {
            @Body
        }
        else if (_failed)
        {
            <h1>The diary did not open</h1>
            <p class="lede">Reload the page to start again from the seeded bookings.</p>
        }
        else
        {
            <p class="boot">Opening the diary…</p>
        }
    </div>
</div>

@code {
    private bool _failed;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || Session.IsReady || _failed)
            return;

        try
        {
            await Session.InitializeAsync(Nav.Uri);
        }
        catch (JSException)
        {
            _failed = true;
        }

        StateHasChanged();
    }
}
