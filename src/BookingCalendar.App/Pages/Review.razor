@page "/review"
@inject StudioSession Session
@inject NavigationManager Nav

<PageTitle>Confirm · @Catalog.BusinessName</PageTitle>

@if (_ready && _service is not null && _date is DateOnly date && _start is TimeOnly start && _end is TimeOnly end)
{
    <a class="back" href="/details">Back</a>
    <h1>Confirm</h1>
    <BookingSummary ServiceName="@_service.Name"
                    LengthMinutes="@_service.LengthMinutes"
                    DateText="@DiaryText.Date(date)"
                    TimeText="@DiaryText.Range(start, end)"
                    CustomerName="@Session.Name"
                    CustomerEmail="@Session.Email" />

    @if (_taken)
    {
        <p class="banner" role="alert">That time has just been taken.</p>
        <a class="back" href="/times">Pick another time</a>
    }

    <button type="button" class="primary" disabled="@_saving" aria-busy="@_saving" data-saving="@(_saving ? "true" : null)" @onclick="Confirm">
        @(_saving ? "Saving…" : "Confirm booking")
    </button>
}

@code {
    private bool _ready;
    private bool _saving;
    private bool _taken;
    private Service? _service;
    private DateOnly? _date;
    private TimeOnly? _start;
    private TimeOnly? _end;

    protected override void OnInitialized()
    {
        _service = Session.SelectedService;
        _date = Session.CustomerDate;
        _start = Session.CustomerStart;
        _end = Session.CustomerEnd;
        if (_service is null || _date is null || _start is null || CustomerDetails.NameError(Session.Name) is not null)
        {
            Nav.NavigateTo("/");
            return;
        }

        _ready = true;
    }

    private async Task Confirm()
    {
        if (_saving)
            return;

        _saving = true;
        _taken = false;
        await Task.Delay(StudioSession.SaveDelay);

        var booking = Session.TryConfirm();
        if (booking is null)
        {
            _saving = false;
            _taken = true;
            return;
        }

        await Session.SaveAsync();
        Nav.NavigateTo($"/confirmation/{booking.BookingReference}");
    }
}
