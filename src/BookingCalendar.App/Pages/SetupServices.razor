@page "/setup/services"
@inject StudioSession Session
@inject NavigationManager Nav

<PageTitle>Services · @Catalog.BusinessName</PageTitle>

<a class="back" href="/setup">Back</a>
<h1>Services</h1>
<div class="choices">
    @foreach (var service in Catalog.Services)
    {
        <label class="check">
            <input type="checkbox"
                   checked="@_ids.Contains(service.Id)"
                   @onchange="eventArgs => Toggle(service.Id, eventArgs)" />
            <span>
                <span class="choice-title">@service.Name</span>
                <span class="choice-copy">@service.LengthMinutes min · @service.Summary</span>
            </span>
        </label>
    }
</div>
@if (_error is not null)
{
    <p class="field-error" role="alert">@_error</p>
}
<button type="button" class="primary" @onclick="Continue">Get link</button>

@code {
    private readonly HashSet<string> _ids = new(StringComparer.Ordinal);
    private string? _error;

    protected override void OnInitialized()
    {
        foreach (var service in Session.Offered)
            _ids.Add(service.Id);
    }

    private void Toggle(string id, ChangeEventArgs args)
    {
        if (args.Value is bool on && on)
            _ids.Add(id);
        else
            _ids.Remove(id);
    }

    private async Task Continue()
    {
        if (!ServiceSelection.IsValid(_ids))
        {
            _error = "Choose 1 to 3 services.";
            return;
        }

        await Session.SaveSetupAsync(Session.Schedule, _ids.ToList());
        Nav.NavigateTo("/setup/link");
    }
}
