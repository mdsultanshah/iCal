@page "/cancel/{Reference}"
@inject StudioSession Session
@inject NavigationManager Nav

<PageTitle>Cancel · @Catalog.BusinessName</PageTitle>

@if (_cancelled is { } cancelled)
{
    var shown = Session.Display(cancelled);
    <h1>Cancelled</h1>
    <p class="note">This booking is cancelled. The time is free again.</p>
    <BookingSummary ServiceName="@cancelled.ServiceName"
                    LengthMinutes="@cancelled.LengthMinutes"
                    DateText="@DiaryText.Date(shown.Date)"
                    TimeText="@DiaryText.Range(shown.Start, shown.End)"
                    CustomerName="@cancelled.CustomerName"
                    CustomerEmail="@cancelled.CustomerEmail" />
    <button type="button" class="primary" @onclick="BookAnother">Book another</button>
}
else if (_booking is null)
{
    <h1>Cancel a booking</h1>
    <p class="banner" role="alert">This booking was not found or is already cancelled.</p>
    <a class="back" href="/">Back</a>
}
else if (_booking is { } active)
{
    var shown = Session.Display(active);
    <h1>Cancel this booking?</h1>
    <BookingSummary ServiceName="@active.ServiceName"
                    LengthMinutes="@active.LengthMinutes"
                    DateText="@DiaryText.Date(shown.Date)"
                    TimeText="@DiaryText.Range(shown.Start, shown.End)"
                    CustomerName="@active.CustomerName"
                    CustomerEmail="@active.CustomerEmail" />
    <div class="actions">
        <button type="button" class="primary" @onclick="ConfirmCancel">Cancel this booking</button>
        <button type="button" class="secondary" @onclick="Keep">Keep my booking</button>
    </div>
}

@code {
    [Parameter] public string Reference { get; set; } = "";

    private Booking? _booking;
    private Booking? _cancelled;

    protected override void OnParametersSet()
    {
        if (_cancelled is not null)
            return;

        _booking = Session.FindActive(Reference);
    }

    private async Task ConfirmCancel()
    {
        var booking = Session.FindAny(Reference);
        if (booking is null || booking.IsCancelled || !Session.Cancel(Reference))
        {
            _booking = null;
            return;
        }

        await Session.SaveAsync();
        _cancelled = booking with { IsCancelled = true };
        _booking = null;
    }

    private void Keep() => Nav.NavigateTo($"/confirmation/{Reference}");

    private void BookAnother()
    {
        Session.ClearDraft();
        Nav.NavigateTo("/");
    }
}
