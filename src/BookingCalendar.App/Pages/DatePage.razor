@page "/date"
@inject StudioSession Session
@inject NavigationManager Nav

<PageTitle>Select a date · @Catalog.BusinessName</PageTitle>

<a class="back" href="/">Back</a>
<h1>Select a date</h1>
<MonthCalendar Days="_days" Selected="Session.CustomerDate" State="StateOf" OnPick="Choose" />

@code {
    private readonly List<DateOnly> _days = [];

    protected override void OnInitialized()
    {
        if (Session.SelectedService is null)
        {
            Nav.NavigateTo("/");
            return;
        }

        Session.RefreshClock();
        _days.AddRange(Availability.CalendarDays(Session.Today));
    }

    private DayState StateOf(DateOnly day) => Session.StateFor(day);

    private void Choose(DateOnly day)
    {
        if (!Availability.CanPick(Session.StateFor(day)))
            return;

        Session.SelectDate(day);
        Nav.NavigateTo("/times");
    }
}
