@page "/"
@implements IAsyncDisposable
@inject AppointmentStore Store
@inject IJSRuntime JS

<PageTitle>Appointments · North Quay Studio</PageTitle>

<div class="page" data-view="@Store.View" data-theme="@(Store.Dark ? "dark" : "light")">
    <div class="card">
        <header class="top" data-header>
            <h1 class="brand">North Quay Studio</h1>
            <div class="tools">
                <div class="views" role="group" aria-label="Calendar view">
                    <button type="button" aria-label="Month" aria-pressed="@Pressed(Store.View == "month")" @onclick='() => Store.SetView("month")'>
                        <svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true">
                            <rect x="1.5" y="1.5" width="5" height="5" rx="1" fill="none" stroke="currentColor" stroke-width="1.5" />
                            <rect x="9.5" y="1.5" width="5" height="5" rx="1" fill="none" stroke="currentColor" stroke-width="1.5" />
                            <rect x="1.5" y="9.5" width="5" height="5" rx="1" fill="none" stroke="currentColor" stroke-width="1.5" />
                            <rect x="9.5" y="9.5" width="5" height="5" rx="1" fill="none" stroke="currentColor" stroke-width="1.5" />
                        </svg>
                    </button>
                    <button type="button" aria-label="Week" aria-pressed="@Pressed(Store.View == "week")" @onclick='() => Store.SetView("week")'>
                        <svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true">
                            <path d="M2 4.5h12M2 8h12M2 11.5h12" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
                        </svg>
                    </button>
                    <button type="button" aria-label="Day" aria-pressed="@Pressed(Store.View == "day")" @onclick='() => Store.SetView("day")'>
                        <svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true">
                            <rect x="5" y="1.5" width="6" height="13" rx="1" fill="none" stroke="currentColor" stroke-width="1.5" />
                        </svg>
                    </button>
                </div>
                <button type="button" class="icon theme" aria-label="@(Store.Dark ? "Use light theme" : "Use dark theme")" @onclick="Store.ToggleThemeAsync">
                    @if (Store.Dark)
                    {
                        <svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true">
                            <circle cx="8" cy="8" r="2.4" fill="none" stroke="currentColor" stroke-width="1.5" />
                            <path d="M8 1.4v1.8M8 12.8v1.8M1.4 8h1.8M12.8 8h1.8M3.2 3.2l1.3 1.3M11.5 11.5l1.3 1.3M3.2 12.8l1.3-1.3M11.5 4.5l1.3-1.3" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
                        </svg>
                    }
                    else
                    {
                        <svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true">
                            <path d="M9.2 2.1a5.4 5.4 0 1 0 4.6 8.4A4.5 4.5 0 0 1 9.2 2.1z" fill="currentColor" />
                        </svg>
                    }
                </button>
            </div>
        </header>

        <div class="columns @(Store.View == "month" ? "is-month" : "is-hours")">
            <section class="details" data-panel="@Mode" aria-labelledby="panel-title">
                @if (Mode == "delete")
                {
                    <h2 id="panel-title">Delete this appointment?</h2>
                    <div class="actions">
                        <button type="button" id="keep-appointment" class="ghost" @onclick="Close">Keep</button>
                        <button type="button" id="confirm-delete" class="danger" @onclick="ConfirmDelete">Delete</button>
                    </div>
                }
                else if (Mode == "clear")
                {
                    <h2 id="panel-title">Clear example appointments?</h2>
                    <p class="note">This removes the sample appointments. Appointments you added stay.</p>
                    <div class="actions">
                        <button type="button" id="keep-examples" class="ghost" @onclick="Close">Keep</button>
                        <button type="button" id="confirm-clear" class="danger" @onclick="ConfirmClear">Clear examples</button>
                    </div>
                }
                else if (_panel is { Mode: "create" or "edit" } panel)
                {
                    <AppointmentEditor @key="panel.Key"
                                      Mode="@panel.Mode"
                                      Id="@panel.Id"
                                      Title="@panel.Title"
                                      Date="@panel.Date"
                                      Start="@panel.Start"
                                      End="@panel.End"
                                      Note="@panel.Note"
                                      IsExample="@panel.IsExample"
                                      TitleError="@_titleError"
                                      DateError="@_dateError"
                                      StartError="@_startError"
                                      EndError="@_endError"
                                      OnClearError="ClearOne"
                                      OnSave="Save"
                                      OnCancel="Close" />
                }
                else if (Mode == "details" && _selected is { } item)
                {
                    <h2 id="panel-title">@item.Title</h2>
                    @if (item.IsExample)
                    {
                        <p class="example-flag"><span class="badge" aria-label="Example">Ex</span></p>
                    }
                    <p class="when">@CalendarText.FullDate(item.Date)</p>
                    <p class="when">@CalendarText.ClockRange(item.Start, item.End, Store.Use24Hour)</p>
                    <p class="note">@(string.IsNullOrWhiteSpace(item.Note) ? "No notes." : item.Note)</p>
                    <div class="actions">
                        <button type="button" id="edit-appointment" class="ghost" @onclick="BeginEdit">Edit</button>
                        <button type="button" id="delete-appointment" class="danger" @onclick="AskDelete">Delete</button>
                    </div>
                    @if (Store.HasExamples)
                    {
                        <button type="button" class="ghost clear" @onclick="OpenClear">Clear examples</button>
                    }
                }
                else
                {
                    <h2 id="panel-title">Appointments</h2>
                    <p class="note">Select an appointment, or create one.</p>
                    @if (Store.HasExamples)
                    {
                        <button type="button" class="ghost clear" @onclick="OpenClear">Clear examples</button>
                    }
                }
                <p class="zone">@Store.ZoneLabel</p>
            </section>

            @if (Store.View == "month")
            {
                <section class="month">
                    <div class="month-head">
                        <h2 class="month-title">
                            <span class="month-name">@CalendarText.Month(Store.Cursor)</span>
                            <span class="year">@Store.Cursor.Year</span>
                        </h2>
                        <div class="pager">
                            <button type="button" class="icon" aria-label="Previous month" @onclick="Store.Previous">
                                <svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true">
                                    <path d="M10 3L5 8l5 5" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
                                </svg>
                            </button>
                            <button type="button" class="today" @onclick="Store.ShowToday">Today</button>
                            <button type="button" class="icon" aria-label="Next month" @onclick="Store.Next">
                                <svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true">
                                    <path d="M6 3l5 5-5 5" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
                                </svg>
                            </button>
                        </div>
                    </div>
                    <MonthGrid Days="@CalendarRange.MonthGrid(Store.Cursor)"
                               Appointments="Store.Appointments"
                               Selected="Store.Cursor"
                               Today="Store.Today"
                               OnSelect="SelectDay" />
                </section>
                <section class="daylist">
                    <div class="day-tools" @onclick:stopPropagation="true">
                        <div class="clock" role="group" aria-label="Time format">
                            <button type="button" aria-pressed="@Pressed(!Store.Use24Hour)" @onclick="() => Store.SetClockAsync(false)">12h</button>
                            <button type="button" aria-pressed="@Pressed(Store.Use24Hour)" @onclick="() => Store.SetClockAsync(true)">24h</button>
                        </div>
                        <button type="button" id="new-appointment" class="primary" @onclick="OpenNew">
                            <svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true">
                                <path d="M8 3v10M3 8h10" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
                            </svg>
                            New appointment
                        </button>
                    </div>
                    <h2 class="day-heading">@CalendarText.DayTitle(Store.Cursor)</h2>
                    <div class="appointments" @onclick="ListBackground">
                        @if (DayAppointments.Count == 0)
                        {
                            <p class="empty">No appointments this day.</p>
                        }
                        else
                        {
                            @foreach (var item in DayAppointments)
                            {
                                <button type="button"
                                        class="appt"
                                        data-appointment="@item.Id"
                                        aria-label="@ListLabel(item)"
                                        @onclick="() => OpenAppointment(item)"
                                        @onclick:stopPropagation="true">
                                    <span class="appt-time">@CalendarText.ClockRange(item.Start, item.End, Store.Use24Hour)</span>
                                    <span class="appt-title">@item.Title</span>
                                    @if (item.IsExample)
                                    {
                                        <span class="badge" aria-hidden="true">Ex</span>
                                    }
                                </button>
                            }
                        }
                    </div>
                </section>
            }
            else
            {
                <section class="hours">
                    <div class="hours-head">
                        <div class="pager">
                            <button type="button" class="icon" aria-label="@PreviousLabel" @onclick="Store.Previous">
                                <svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true">
                                    <path d="M10 3L5 8l5 5" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
                                </svg>
                            </button>
                            <button type="button" class="today" @onclick="Store.ShowToday">Today</button>
                            <button type="button" class="icon" aria-label="@NextLabel" @onclick="Store.Next">
                                <svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true">
                                    <path d="M6 3l5 5-5 5" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
                                </svg>
                            </button>
                        </div>
                        <h2 class="hours-title">@HoursTitle</h2>
                        <div class="clock" role="group" aria-label="Time format">
                            <button type="button" aria-pressed="@Pressed(!Store.Use24Hour)" @onclick="() => Store.SetClockAsync(false)">12h</button>
                            <button type="button" aria-pressed="@Pressed(Store.Use24Hour)" @onclick="() => Store.SetClockAsync(true)">24h</button>
                        </div>
                        <button type="button" id="new-appointment" class="primary" @onclick="OpenNew">
                            <svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true">
                                <path d="M8 3v10M3 8h10" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
                            </svg>
                            New appointment
                        </button>
                    </div>
                    <AppointmentGrid Days="Store.VisibleDays"
                                     Appointments="Store.Appointments"
                                     Today="Store.Today"
                                     Selected="Store.Cursor"
                                     Use24Hour="Store.Use24Hour"
                                     OnSlot="OpenSlot"
                                     OnOpen="OpenAppointment" />
                </section>
            }
        </div>
    </div>
</div>

<div class="live" aria-live="polite" aria-atomic="true">
    @if (Store.Toast is { } toast)
    {
        <p class="toast" data-toast>@toast</p>
    }
</div>

@code {
    private PanelRequest? _panel;
    private Appointment? _selected;
    private string? _titleError;
    private string? _dateError;
    private string? _startError;
    private string? _endError;
    private bool _focusKeep;
    private bool _focusNew;
    private bool _escapeBound;
    private DotNetObjectReference<CalendarPage>? _self;

    private string Mode => _panel?.Mode ?? "idle";

    private IReadOnlyList<Appointment> DayAppointments =>
        Store.Appointments
            .Where(item => item.Date == Store.Cursor)
            .OrderBy(item => item.Start)
            .ThenBy(item => item.Id, StringComparer.Ordinal)
            .ToList();

    private string HoursTitle =>
        Store.View == "day"
            ? CalendarText.DayTitle(Store.Cursor)
            : CalendarText.WeekTitle(Store.VisibleDays);

    private string PreviousLabel => Store.View == "day" ? "Previous day" : "Previous week";

    private string NextLabel => Store.View == "day" ? "Next day" : "Next week";

    protected override void OnInitialized() => Store.Changed += OnChanged;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await SyncEscapeAsync();

        if (_focusKeep)
        {
            _focusKeep = false;
            var selector = Mode == "clear" ? "#keep-examples" : "#keep-appointment";
            await FocusAsync(selector);
        }

        if (_focusNew)
        {
            _focusNew = false;
            await FocusAsync("#new-appointment");
        }
    }

    public async ValueTask DisposeAsync()
    {
        Store.Changed -= OnChanged;
        try
        {
            await JS.InvokeVoidAsync("northQuay.unbindEscape");
        }
        catch (JSException)
        {
            // The page is going away.
        }

        _self?.Dispose();
    }

    [JSInvokable]
    public void CloseFromKey()
    {
        Close();
        StateHasChanged();
    }

    private void OnChanged()
    {
        if (_selected is { } selected)
        {
            var fresh = Store.Appointments.FirstOrDefault(item => item.Id == selected.Id);
            if (fresh is null)
            {
                _selected = null;
                if (_panel?.Mode is "details" or "edit" or "delete")
                    _panel = null;
            }
            else
            {
                _selected = fresh;
            }
        }

        try
        {
            _ = InvokeAsync(StateHasChanged);
        }
        catch (ObjectDisposedException)
        {
            // The page is going away.
        }
    }

    private void SelectDay(DateOnly date)
    {
        var cleared = false;
        if (_selected is { } item && item.Date != date)
        {
            _selected = null;
            if (_panel?.Mode is "details" or "edit" or "delete")
            {
                _panel = null;
                cleared = true;
            }
        }

        var moved = Store.Cursor != date;
        Store.Select(date);
        if (cleared && !moved)
            StateHasChanged();
    }

    private void ListBackground()
    {
        if (Store.Narrow)
            OpenNew();
    }

    private void OpenSlot(SlotChoice choice)
    {
        var start = new TimeOnly(choice.Hour, 0);
        Store.Select(choice.Date);
        Open(new PanelRequest(
            $"create-{CalendarText.DateValue(choice.Date)}-{choice.Hour}",
            "create",
            null,
            "",
            CalendarText.DateValue(choice.Date),
            CalendarText.Time(start),
            CalendarText.Time(CalendarRange.DefaultEnd(start)),
            "",
            false));
    }

    private void OpenNew()
    {
        var start = new TimeOnly(9, 0);
        Open(new PanelRequest(
            $"create-button-{CalendarText.DateValue(Store.Cursor)}",
            "create",
            null,
            "",
            CalendarText.DateValue(Store.Cursor),
            CalendarText.Time(start),
            CalendarText.Time(CalendarRange.DefaultEnd(start)),
            "",
            false));
    }

    private void OpenAppointment(Appointment item)
    {
        Store.Select(item.Date);
        _selected = item;
        Open(DetailsRequest(item));
    }

    private void BeginEdit()
    {
        if (_selected is not { } item)
            return;

        Open(new PanelRequest(
            $"edit-{item.Id}",
            "edit",
            item.Id,
            item.Title,
            CalendarText.DateValue(item.Date),
            CalendarText.Time(item.Start),
            CalendarText.Time(item.End),
            item.Note,
            item.IsExample));
    }

    private void OpenClear()
    {
        _focusKeep = true;
        Open(new PanelRequest("clear", "clear", null, "", "", "", "", "", false));
    }

    private void AskDelete()
    {
        if (_selected is not { } item)
            return;

        _focusKeep = true;
        Open(new PanelRequest($"delete-{item.Id}", "delete", item.Id, item.Title, "", "", "", "", item.IsExample));
    }

    private async Task Save(AppointmentDraft draft)
    {
        var titleError = AppointmentRules.TitleError(draft.Title);
        var dateOk = PrototypeOptions.TryParseDate(draft.Date, out var date);
        var startOk = CalendarText.TryParseTime(draft.Start, out var start);
        var endOk = CalendarText.TryParseTime(draft.End, out var end);
        string? timeError = null;
        if (startOk && endOk)
            timeError = AppointmentRules.TimeOrderError(start, end);

        if (titleError is not null || !dateOk || !startOk || !endOk || timeError is not null)
        {
            _titleError = titleError;
            _dateError = dateOk ? null : "Enter a date.";
            _startError = startOk ? null : "Enter a start.";
            _endError = !endOk ? "Enter an end." : timeError;
            return;
        }

        var before = Store.Appointments.Select(item => item.Id).ToHashSet(StringComparer.Ordinal);
        var outcome = await Store.SaveAsync(draft.Id, draft.Title, date, start, end, draft.Note);
        if (!outcome.Ok)
        {
            _titleError = outcome.TitleError;
            _endError = outcome.TimeError;
            return;
        }

        var saved = outcome.Appointments.FirstOrDefault(item => item.Id == draft.Id)
            ?? outcome.Appointments.First(item => !before.Contains(item.Id));
        _selected = saved;
        Store.Select(saved.Date);
        Open(DetailsRequest(saved));
    }

    private async Task ConfirmDelete()
    {
        if (_panel?.Id is not { } id)
            return;

        _panel = null;
        _selected = null;
        _focusNew = true;
        await Store.DeleteAsync(id);
    }

    private async Task ConfirmClear()
    {
        _panel = null;
        _focusNew = true;
        await Store.ClearExamplesAsync();
    }

    private void Close()
    {
        ClearErrors();
        if (_panel?.Mode is "edit" or "delete" or "clear" && _selected is not null)
        {
            Open(DetailsRequest(_selected));
            return;
        }

        _panel = null;
        _focusNew = true;
    }

    private void Open(PanelRequest request)
    {
        ClearErrors();
        _panel = request;
    }

    private static PanelRequest DetailsRequest(Appointment item) =>
        new(
            $"details-{item.Id}",
            "details",
            item.Id,
            item.Title,
            CalendarText.DateValue(item.Date),
            CalendarText.Time(item.Start),
            CalendarText.Time(item.End),
            item.Note,
            item.IsExample);

    private void ClearOne(string field)
    {
        switch (field)
        {
            case "title":
                _titleError = null;
                break;
            case "date":
                _dateError = null;
                break;
            case "start":
                _startError = null;
                break;
            case "end":
                _endError = null;
                break;
        }
    }

    private void ClearErrors()
    {
        _titleError = null;
        _dateError = null;
        _startError = null;
        _endError = null;
    }

    private string ListLabel(Appointment item)
    {
        var kind = item.IsExample ? "Example. " : "";
        return $"{kind}{item.Title}, {CalendarText.ClockRange(item.Start, item.End, Store.Use24Hour)}";
    }

    private static string Pressed(bool on) => on ? "true" : "false";

    private async Task SyncEscapeAsync()
    {
        var open = _panel is not null && Mode is not "details";
        if (open == _escapeBound)
            return;

        try
        {
            if (open)
            {
                _self ??= DotNetObjectReference.Create(this);
                await JS.InvokeVoidAsync("northQuay.bindEscape", _self);
            }
            else
            {
                await JS.InvokeVoidAsync("northQuay.unbindEscape");
            }

            _escapeBound = open;
        }
        catch (JSException)
        {
            // The page is going away.
        }
    }

    private async Task FocusAsync(string selector)
    {
        try
        {
            await JS.InvokeVoidAsync("northQuay.focus", selector);
        }
        catch (JSException)
        {
            // The page is going away.
        }
    }

    private sealed record PanelRequest(
        string Key,
        string Mode,
        string? Id,
        string Title,
        string Date,
        string Start,
        string End,
        string Note,
        bool IsExample);
}
