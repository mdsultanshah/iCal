@page "/confirmation/{Reference}"
@inject StudioSession Session

<PageTitle>Booking confirmed · @Catalog.BusinessName</PageTitle>

@if (_booking is null)
{
    <p class="kicker">Booking</p>
    <h1>Booking not found</h1>
    <p class="lede">This booking reference is not in this browser.</p>
    <a class="text-link" href="/">Back to services</a>
}
else
{
    <p class="kicker">Booking</p>
    <h1>Booking confirmed</h1>
    <p class="lede">You are booked with @Catalog.ProviderName. Keep the booking reference, or use the cancel link if you need the slot back.</p>

    <BookingSummary ServiceName="@_booking.ServiceName"
                    LengthMinutes="@_booking.LengthMinutes"
                    DateText="@DiaryText.Date(_booking.Date)"
                    SlotText="@DiaryText.Slot(_booking.Start, BookingRules.FromMinutes(BookingRules.ToMinutes(_booking.Start) + _booking.LengthMinutes))"
                    CustomerName="@_booking.CustomerName"
                    CustomerEmail="@_booking.CustomerEmail" />

    <p class="label">Booking reference</p>
    <p class="reference">@_booking.BookingReference</p>

    <p class="label">Cancel link</p>
    <a class="cancel-link" href="@CancelLink.For(_booking.BookingReference)">@CancelLink.For(_booking.BookingReference)</a>
}

@code {
    [Parameter] public string Reference { get; set; } = "";
    private Booking? _booking;

    protected override void OnParametersSet()
    {
        _booking = Session.FindAny(Reference);
    }
}
