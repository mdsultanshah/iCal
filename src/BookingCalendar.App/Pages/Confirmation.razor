@page "/confirmation/{Reference}"
@inject StudioSession Session
@inject NavigationManager Nav

<PageTitle>Booking confirmed · @Catalog.BusinessName</PageTitle>

@if (_booking is null)
{
    <h1>Booking not found</h1>
    <a class="back" href="/">Back</a>
}
else if (_booking is { } booking)
{
    var shown = Session.Display(booking);
    <h1>Booking confirmed</h1>
    <BookingSummary ServiceName="@booking.ServiceName"
                    LengthMinutes="@booking.LengthMinutes"
                    DateText="@DiaryText.Date(shown.Date)"
                    TimeText="@DiaryText.Range(shown.Start, shown.End)"
                    CustomerName="@booking.CustomerName"
                    CustomerEmail="@booking.CustomerEmail" />

    <p class="label">Booking reference</p>
    <CopyRow Text="@booking.BookingReference" />

    <p class="label">Cancel link</p>
    <CopyRow Text="@_cancelUrl" Href="@CancelLink.For(booking.BookingReference)" CopyText="@_cancelUrl" />

    <p class="label">Reschedule link</p>
    <CopyRow Text="@_rescheduleUrl" Href="@RescheduleLink.For(booking.BookingReference)" CopyText="@_rescheduleUrl" />

    <p class="note">This link works only in this browser on this device</p>
    <button type="button" class="primary" @onclick="BookAnother">Book another</button>
}

@code {
    [Parameter] public string Reference { get; set; } = "";

    private Booking? _booking;
    private string _cancelUrl = "";
    private string _rescheduleUrl = "";

    protected override void OnParametersSet()
    {
        _booking = Session.FindAny(Reference);
        if (_booking is null)
            return;

        _cancelUrl = Nav.ToAbsoluteUri(CancelLink.For(_booking.BookingReference)).ToString();
        _rescheduleUrl = Nav.ToAbsoluteUri(RescheduleLink.For(_booking.BookingReference)).ToString();
    }

    private void BookAnother()
    {
        Session.ClearDraft();
        Nav.NavigateTo("/");
    }
}
