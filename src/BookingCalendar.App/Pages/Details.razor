@page "/details"
@inject StudioSession Session
@inject NavigationManager Nav

<PageTitle>Your details · @Catalog.BusinessName</PageTitle>

@if (_ready)
{
    <a class="back" href="/times">Back</a>
    <h1>Your details</h1>
    <form @onsubmit="Submit" @onsubmit:preventDefault>
        <label class="field" for="customer-name">
            <span>Name</span>
            <input id="customer-name"
                   @bind="_name"
                   @bind:event="oninput"
                   autocomplete="name"
                   aria-invalid="@(_nameError is not null)"
                   aria-describedby="@(_nameError is null ? null : "name-error")" />
            @if (_nameError is not null)
            {
                <span class="field-error" id="name-error" role="alert">@_nameError</span>
            }
        </label>
        <label class="field" for="customer-email">
            <span>Email</span>
            <input id="customer-email"
                   @bind="_email"
                   @bind:event="oninput"
                   autocomplete="email"
                   inputmode="email"
                   aria-invalid="@(_emailError is not null)"
                   aria-describedby="@(_emailError is null ? null : "email-error")" />
            @if (_emailError is not null)
            {
                <span class="field-error" id="email-error" role="alert">@_emailError</span>
            }
        </label>
        <button class="primary" type="submit">Continue</button>
    </form>
}

@code {
    private bool _ready;
    private string _name = "";
    private string _email = "";
    private string? _nameError;
    private string? _emailError;

    protected override void OnInitialized()
    {
        if (Session.SelectedService is null || Session.CustomerStart is null)
        {
            Nav.NavigateTo("/");
            return;
        }

        _name = Session.Name;
        _email = Session.Email;
        _ready = true;
    }

    private void Submit()
    {
        _nameError = CustomerDetails.NameError(_name);
        _emailError = CustomerDetails.EmailError(_email);
        if (_nameError is not null || _emailError is not null)
            return;

        Session.SetDetails(_name, _email);
        Nav.NavigateTo("/review");
    }
}
