@page "/"
@inject StudioSession Session
@inject NavigationManager Nav

<PageTitle>Services · @Catalog.BusinessName</PageTitle>

<FlowHead Step="1" Title="Choose a service" />
<p class="lede">@Catalog.BusinessName books @Catalog.ProviderName. Pick a service. Each one has a fixed length.</p>

<ul class="cards">
    @foreach (var service in Catalog.Services)
    {
        <li>
            <button type="button" class="card" data-service="@service.Id" @onclick="() => Choose(service)">
                <span class="card-kicker">Service</span>
                <span class="card-title">@service.Name</span>
                <span class="card-meta">@service.LengthMinutes minutes</span>
                <span class="card-copy">@service.Summary</span>
            </button>
        </li>
    }
</ul>

@code {
    private void Choose(Service service)
    {
        Session.SelectService(service);
        Nav.NavigateTo("/date");
    }
}
