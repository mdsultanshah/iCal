@page "/"
@inject StudioSession Session
@inject NavigationManager Nav

<PageTitle>Choose a service · @Catalog.BusinessName</PageTitle>

<h1>Choose a service</h1>
<ul class="choices">
    @foreach (var service in Session.Offered)
    {
        <li>
            <button type="button" class="choice" data-service="@service.Id" @onclick="() => Choose(service)">
                <span>
                    <span class="choice-title">@service.Name</span>
                    <span class="choice-copy">@service.Summary</span>
                </span>
                <span class="choice-meta">@service.LengthMinutes min</span>
            </button>
        </li>
    }
</ul>

@code {
    private void Choose(Service service)
    {
        Session.SelectService(service);
        Nav.NavigateTo("/date");
    }
}
