@page "/setup/link"
@inject NavigationManager Nav

<PageTitle>Share link · @Catalog.BusinessName</PageTitle>

<h1>Share link</h1>
<p class="label">Share link</p>
<CopyRow Text="@_url" Href="/" CopyText="@_url" />
<p class="note">This link works only in this browser on this device</p>
<a class="primary" href="/">Open booking page</a>

@code {
    private string _url = "";

    protected override void OnInitialized()
    {
        _url = Nav.BaseUri;
    }
}
