@page "/slots"
@inject StudioSession Session
@inject NavigationManager Nav

<PageTitle>Slots · @Catalog.BusinessName</PageTitle>

@if (_service is not null && _date is DateOnly date)
{
    <FlowHead Step="3" Title="Choose a slot" />
    <p class="lede">@DiaryText.Date(date) · @_service.Name · @_service.LengthMinutes minutes. Taken and past times are not offered.</p>
    <a class="back" href="/date">Back to dates</a>

    @if (_slots.Count == 0)
    {
        <div class="empty">
            <p class="empty-title">No times left on this day</p>
            @if (_next is DateOnly next)
            {
                <button type="button" class="primary next-day" data-next-day="@DiaryText.Iso(next)" @onclick="() => Go(next)">
                    <span class="next-kicker">Next day with free times</span>
                    <span class="next-date">@DiaryText.Date(next)</span>
                </button>
            }
            else
            {
                <p class="quiet">No later day in these 14 days has a free slot.</p>
            }
        </div>
    }
    else
    {
        <div class="slots">
            @foreach (var slot in _slots)
            {
                <button type="button" class="slot" data-slot="@DiaryText.Time(slot.Start)" @onclick="() => Choose(slot.Start)">
                    <span class="slot-time">@DiaryText.Time(slot.Start)</span>
                    <span class="slot-end">to @DiaryText.Time(slot.End)</span>
                </button>
            }
        </div>
    }
}

@code {
    private Service? _service;
    private DateOnly? _date;
    private List<Slot> _slots = [];
    private DateOnly? _next;

    protected override void OnInitialized()
    {
        Load();
    }

    private void Load()
    {
        _service = Session.SelectedService;
        _date = Session.Date;
        if (_service is null || _date is null)
        {
            Nav.NavigateTo(_service is null ? "/" : "/date");
            return;
        }

        Session.RefreshClock();
        _slots = BookingRules.FreeSlots(_service, _date.Value, Session.Today, Session.Now, Session.Bookings).ToList();
        _next = BookingRules.NextDayWithFreeSlots(_service, _date.Value, Session.Today, Session.Now, Session.Bookings);
    }

    private void Choose(TimeOnly start)
    {
        Session.SelectSlot(start);
        Nav.NavigateTo("/details");
    }

    private void Go(DateOnly day)
    {
        Session.SelectDate(day);
        Load();
    }
}
